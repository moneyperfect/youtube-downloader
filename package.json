{
  "name": "yt-downloader",
  "version": "2.0.0",
  "description": "YouTube 视频下载器 - Node.js 版",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "pkg . --targets node18-win-x64 --output dist/yt-downloader.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "config.json",
      "bin/**/*"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "express": "^4.18.2",
    "qrcode": "^1.5.3",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
